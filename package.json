{
  "name": "todays-dollars",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev-https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "generate": "prisma generate && next typegen",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "ci": "npm run generate && npm run typecheck && npm run test && npm run lint && npm run format:check",
    "agent:setup": "npm run copy-env && npm run db:up && npm run prisma:bootstrap",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down -v",
    "db:reset": "npm run db:down && npm run db:up && npm run prisma:bootstrap",
    "db:test:up": "docker compose up -d --wait db-test",
    "db:test:down": "docker compose rm -sf db-test",
    "copy-env": "tsx scripts/safe-copy-env.ts",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:bootstrap": "prisma migrate deploy && prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@icons-pack/react-simple-icons": "^12.9.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "react-is": "^19.0.0"
  }
}
